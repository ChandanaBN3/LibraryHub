# Copy this file to ".env" (same folder) and change the values.
# The ".env" file is ignored by git so your secrets are never uploaded.

# Used to sign login sessions and CSRF tokens. Use a long random text, e.g. run:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-text

# Optional: store the database somewhere else (default: instance/libraryhub.sqlite3)
# DATABASE_PATH=C:\path\to\my-library.sqlite3

# Optional: set to 1 to get Flask's debug page (development only, never in production)
# FLASK_DEBUG=1
